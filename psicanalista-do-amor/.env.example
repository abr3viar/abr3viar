# =============================================================================
# Psicanalista do Amor — variáveis de ambiente (plano.md, seção 9)
#
# Este arquivo é só um MODELO, com valores FALSOS. Nunca coloque segredos reais aqui.
# Em produção, cadastre cada variável no painel da hospedagem (ver DEPLOY.md).
# Em desenvolvimento, copie para `.env` (que está no .gitignore) e preencha.
# Variáveis marcadas com 🔐 são segredos.
# =============================================================================

# Ambiente: "development" no seu computador, "production" no servidor.
NODE_ENV=development

# Endereço público do site, sem barra no final. Usado em links de e-mail, no retorno
# do Stripe e na checagem de origem (CSRF). Ex.: https://psicanalistadoamor.com.br
APP_URL=http://localhost:3000

# 🔐 Conexão com o PostgreSQL 16. Copie do painel do banco (Square Cloud → seu banco → URL de conexão).
DATABASE_URL=postgres://app:app@localhost:5432/psicanalista
# SSL do banco: "require" (verifica certificado), "no-verify" (SSL sem verificar) ou "disable".
# Deixe vazio se a própria DATABASE_URL já tiver ?sslmode=... (na Square Cloud use "no-verify",
# a menos que informe a CA abaixo).
DATABASE_SSL=
# 🔐 Certificado de CLIENTE do Postgres (arquivo .pem com chave privada + certificado), em base64.
# Na Square Cloud: baixe o certificado no painel do banco e converta (ver DEPLOY.md).
DATABASE_SSL_CERT_BASE64=
# Alternativa ao base64: caminho do arquivo PEM na raiz do app (o MCP da Square Cloud grava
# certificate.pem e define esta variável). Se as duas existirem, vale o base64.
DATABASE_URL_CERT_PATH=
# Opcional: certificado da autoridade (CA) do servidor do banco, em base64, para verificar o servidor.
DATABASE_SSL_CA_BASE64=
# Máximo de conexões por processo (opcional).
DATABASE_POOL_MAX=10

# 🔐 Chave de 32 bytes em base64 para AES-256-GCM (cifra conversas e relatórios no banco).
# Gere no console do navegador (F12): btoa(String.fromCharCode(...crypto.getRandomValues(new Uint8Array(32))))
# PERDER esta chave = perder todos os dados cifrados. Guarde uma cópia num cofre de senhas.
DATA_ENCRYPTION_KEY=ZmFrZS1rZXktZmFrZS1rZXktZmFrZS1rZXktMDAwMDA=
# 🔐 Chave antiga, só durante a rotação de chave (ver DEPLOY.md). Normalmente vazia.
DATA_ENCRYPTION_KEY_PREVIOUS=

# 🔐 Segredo para assinar cookies de sessão e tokens do link mágico (mínimo 32 caracteres).
# Gere no console do navegador: [...crypto.getRandomValues(new Uint8Array(32))].map(b=>b.toString(16).padStart(2,'0')).join('')
SESSION_SECRET=troque-por-um-segredo-aleatorio-de-64-caracteres-hex-0000000000

# 🔐 "Pepper" para hashes de IP/e-mail no rate limit (mínimo 16 caracteres). Gere igual ao anterior.
HASH_PEPPER=troque-por-outro-segredo-aleatorio-000000

# 🔐 Chave da API da Groq: console.groq.com → API Keys.
GROQ_API_KEY=gsk_fake_troque_pela_sua_chave
# Opcional: endereço alternativo da API (usado só nos testes automatizados com servidor falso).
GROQ_BASE_URL=
# Modelos da Groq (NUNCA fixados no código). Reconfira em console.groq.com/docs/models
# e /docs/deprecations antes de cada deploy.
# Modelo de visão para ler prints (OCR).
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Modelo que escreve o relatório principal e os adicionais.
GROQ_REPORT_MODEL=openai/gpt-oss-120b
# Modelo menor/barato para resumir trechos de conversas longas (etapa "map").
GROQ_SUMMARY_MODEL=openai/gpt-oss-20b
# Esforço de raciocínio dos modelos de relatório/resumo: low | medium | high | none | default.
# Use "off" se o modelo escolhido não for de raciocínio (os parâmetros não são enviados).
GROQ_REASONING_EFFORT=medium
# Quantas imagens o modelo de visão aceita por requisição.
GROQ_VISION_MAX_IMAGES_PER_REQUEST=3
# Quantas chamadas simultâneas à Groq o worker faz no máximo.
GROQ_MAX_CONCURRENCY=2
# Teto de tokens de saída pedidos para o relatório (inclui tokens de raciocínio).
GROQ_REPORT_MAX_COMPLETION_TOKENS=8000
# Conversas até este tamanho (tokens estimados) vão inteiras para o modelo; maiores usam map-reduce.
REPORT_DIRECT_MAX_TOKENS=40000
# Tamanho de cada bloco na etapa "map" das conversas longas.
CHUNK_TOKENS=12000

# 🔐 Chave secreta do Stripe: dashboard.stripe.com → Developers → API keys.
# Use sk_test_... para testes e sk_live_... em produção. O modo (teste/produção) define
# quais Payment Links do /admin são usados.
STRIPE_SECRET_KEY=sk_test_fake_troque_pela_sua_chave
# 🔐 Segredo do webhook: Developers → Webhooks → (seu endpoint) → Signing secret.
STRIPE_WEBHOOK_SECRET=whsec_fake_troque_pelo_seu_segredo
# Taxa do Stripe REPASSADA ao cliente: o preço cobrado = (líquido + fixa) / (1 − percentual),
# arredondado para cima. Ex.: líquido R$ 30,00 → cobra R$ 31,66; R$ 10,00 → R$ 10,83.
# Confira as tarifas reais da SUA conta (cartão e Pix podem ser diferentes; ver DEPLOY.md).
STRIPE_FEE_PERCENT=3.99
STRIPE_FEE_FIXED_CENTS=39
# Tarifa extra do Stripe Billing nas cobranças recorrentes (só a assinatura mensal soma esta
# porcentagem). Confira na sua conta (Stripe → Pricing → Billing). 0 = sem tarifa extra.
STRIPE_SUBSCRIPTION_EXTRA_FEE_PERCENT=0

# Onde guardar os arquivos enviados (temporários, cifrados): "local" (dev) ou "s3" (produção).
STORAGE_DRIVER=local
# Pasta dos arquivos no driver local (fica no .gitignore).
STORAGE_LOCAL_DIR=./.data/uploads
# "1" permite o driver local em produção (Square Cloud: os arquivos ficam no disco do app,
# cifrados, e são apagados após a leitura ou em no máximo 24 h). Deixe 0 se usar S3/R2.
ALLOW_LOCAL_STORAGE_IN_PRODUCTION=0
# Bucket S3-compatível (Cloudflare R2 ou AWS S3) — PRIVADO.
# R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com ; AWS: deixe vazio.
S3_ENDPOINT=
# Região: "auto" no R2; ex. "sa-east-1" na AWS.
S3_REGION=auto
S3_BUCKET=
# 🔐 Credenciais do bucket (R2: "Manage R2 API Tokens"; AWS: usuário IAM).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Envio de e-mail: "smtp" (produção sem domínio próprio, ex.: Gmail), "resend" (exige
# domínio verificado) ou "outbox" (dev/testes: grava em .data/outbox).
EMAIL_DRIVER=outbox
# SMTP (Gmail: smtp.gmail.com, porta 465). SMTP_USER = o endereço Gmail inteiro.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
# 🔐 Gmail: "senha de app" de 16 letras (myaccount.google.com/apppasswords), não a senha da conta.
SMTP_PASSWORD=
# 🔐 Chave da API do Resend: resend.com → API Keys (só com EMAIL_DRIVER=resend).
RESEND_API_KEY=
# Remetente dos e-mails. Com smtp, pode ficar vazio (usa "Psicanalista do Amor <SMTP_USER>").
# Com resend, é obrigatório e precisa ser do domínio verificado.
EMAIL_FROM=
# Orçamento diário de e-mails pelo SMTP. O Gmail bloqueia a conta por até 24 h acima de
# ~500/dia; avisos não essenciais param em 80% e o resto fica para login e pagamento.
SMTP_DAILY_LIMIT=450
# Pasta do driver "outbox" (só dev/testes).
EMAIL_OUTBOX_DIR=./.data/outbox

# Limites de envio (opcionais).
# Tamanho máximo por envio, em bytes (25 MB).
UPLOAD_MAX_BYTES=26214400
# Máximo de prints por análise.
MAX_IMAGES=60
# Tamanho máximo de cada print, em bytes (8 MB).
MAX_IMAGE_BYTES=8388608
# Máximo de caracteres no texto colado.
PASTE_MAX_CHARS=500000
# Teto de envios por hora no site inteiro (protege a cota da Groq contra abuso).
UPLOAD_GLOBAL_MAX_PER_HOUR=120

# Retenção (LGPD): dias sem acesso até apagar análises não pagas / pagas.
RETENTION_UNPAID_DAYS=7
RETENTION_PAID_DAYS=180

# E-mails com acesso ao painel /admin (separados por vírgula).
ADMIN_EMAILS=voce@example.com

# Contatos públicos: suporte (Ajuda/Termos) e encarregado de dados/DPO (Privacidade).
# Obrigatórios antes de abrir ao público. Se PRIVACY_EMAIL ficar vazio, usa o SUPPORT_EMAIL.
SUPPORT_EMAIL=
PRIVACY_EMAIL=

# "1" depois que um(a) advogado(a) revisar Termos e Privacidade: some o aviso "em revisão".
LEGAL_REVIEW_DONE=0

# Nível de log: fatal | error | warn | info | debug | trace | silent.
LOG_LEVEL=info

# Qual processo o container roda: "all" (site + worker juntos), "web" ou "worker".
PROCESS_TYPE=all

# Quantos proxies confiáveis ficam na frente do app (eles acrescentam o IP real ao
# final do X-Forwarded-For). Na Square Cloud/Railway, 1. Usado só para rate limit.
TRUSTED_PROXY_HOPS=1

# Opcional: URL de webhook (Discord/Slack) para alertas sem dados pessoais
# (webhook do Stripe com erro, job que falhou de vez, erro no servidor).
ALERT_WEBHOOK_URL=
